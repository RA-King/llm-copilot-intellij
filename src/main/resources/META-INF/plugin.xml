<idea-plugin>
    <id>com.llmcopilot</id>
    <name>LLM Copilot</name>
    <version>2.0.0</version>
    <vendor email="llmcopilot@example.com" url="https://github.com/llm-copilot">LLM Copilot</vendor>

    <description><![CDATA[
        <p>
            <b>LLM Copilot</b> brings inline AI code completion, an in-editor chat panel,
            and a set of code actions to IntelliJ IDEA &mdash; backed by whichever language
            model you choose, including models running entirely on your own machine.
        </p>

        <h3>Completions that understand where you are</h3>
        <p>
            As you type, a suggestion appears inline in grey. Press <b>Tab</b> to accept it
            or <b>Esc</b> to dismiss. Rather than prompting blindly, the plugin works out
            what the caret is sitting inside &mdash; a class body, an interface, an enum, a
            function body, or top level &mdash; and asks for the appropriate thing: a
            constructor for an empty class, accessors for a class that already has fields,
            the next case for an enum.
        </p>

        <h3>No repeated code</h3>
        <p>
            Language models often re-emit code that is already on screen. Every suggestion
            passes three filters first: echoed prefixes are stripped, whole blocks that
            already exist above or below the caret are rejected, and individual repeated
            lines are dropped. If most of a suggestion is material you already have,
            nothing is shown at all.
        </p>

        <h3>Documentation on request</h3>
        <p>
            Type <code>//</code> or <code>/**</code> on a line of its own above a
            declaration and a documentation comment is drafted for it, in the idiom of the
            language &mdash; <code>#</code> for Python and Ruby, <code>///</code> for Rust,
            <code>//</code> for Go, block comments elsewhere. The result appears in a
            preview dialog: <b>nothing is written to your file until you accept it</b>, and
            the insert is a single undoable action.
        </p>

        <h3>Everything else</h3>
        <ul>
            <li><b>Chat panel</b> &mdash; a tool window that can see the current file and selection</li>
            <li><b>Inline chat</b> &mdash; ask about the code at the caret without leaving the editor</li>
            <li><b>Explain</b>, <b>Fix</b> and <b>Refactor</b> a selection, the last with your own instruction</li>
            <li><b>Generate unit tests</b>, optionally pinned to a specific framework</li>
            <li><b>Generate a constructor</b>, or getters and setters one field at a time</li>
            <li><b>Implement interface methods</b> from a signature</li>
            <li><b>Write a commit message</b> from the current diff</li>
        </ul>

        <h3>Bring your own model</h3>
        <p>
            Thirteen providers are supported. Ollama and LM Studio run entirely locally, so
            <b>your code never leaves your machine</b> and no account is required:
        </p>
        <ul>
            <li><b>Local</b> &mdash; Ollama, LM Studio, or a Claude Code proxy (port and path auto-discovered)</li>
            <li><b>Hosted</b> &mdash; OpenAI, Anthropic, Google Gemini, DeepSeek, xAI Grok, Mistral, Groq, OpenRouter, Azure OpenAI</li>
            <li><b>Custom</b> &mdash; any OpenAI-compatible endpoint</li>
        </ul>
        <p>
            Configure under <b>Settings &rarr; Tools &rarr; LLM Copilot</b>. The defaults
            assume a local Ollama instance, so a local setup needs no configuration at all.
            <b>LLM Copilot: Test Connection</b> confirms the provider is reachable.
        </p>

        <p>
            <em>Note:</em> API keys for hosted providers are stored in the IDE's plugin
            settings file rather than the OS keychain. Prefer a local provider on shared
            machines.
        </p>
    ]]></description>

    <idea-version since-build="261" />

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>

    <extensions defaultExtensionNs="com.intellij">

        <!-- Inline completion -->
        <editorFactoryListener
            implementation="com.llmcopilot.completion.LLMEditorFactoryListener"/>

        <!-- Tool window: AI Chat -->
        <toolWindow
            id="LLM Copilot"
            secondary="false"
            anchor="right"
            factoryClass="com.llmcopilot.chat.LLMChatToolWindowFactory"
            icon="/icons/llmcopilot.svg"/>

        <!-- Settings -->
        <applicationService
            serviceInterface="com.llmcopilot.settings.LLMCopilotSettings"
            serviceImplementation="com.llmcopilot.settings.LLMCopilotSettings"/>
        <applicationConfigurable
            parentId="tools"
            instance="com.llmcopilot.settings.LLMCopilotConfigurable"
            id="com.llmcopilot.settings"
            displayName="LLM Copilot"/>

        <!-- Status bar widget -->
        <statusBarWidgetFactory
            id="LLMCopilotStatusBar"
            implementation="com.llmcopilot.ui.LLMStatusBarWidgetFactory"
            order="first"/>

        <!-- Notification group -->
        <notificationGroup
            id="LLM Copilot"
            displayType="BALLOON"/>

    </extensions>

    <actions>
        <!-- Trigger inline completion -->
        <action id="LLMCopilot.TriggerCompletion"
                class="com.llmcopilot.actions.TriggerCompletionAction"
                text="Trigger LLM Completion"
                description="Manually trigger LLM ghost text completion">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift SPACE"/>
        </action>

        <!-- Open AI Chat -->
        <action id="LLMCopilot.OpenChat"
                class="com.llmcopilot.actions.OpenChatAction"
                text="Open LLM Chat"
                description="Open the AI chat panel">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt I"/>
        </action>

        <!-- Inline chat -->
        <action id="LLMCopilot.InlineChat"
                class="com.llmcopilot.actions.InlineChatAction"
                text="LLM Copilot: Inline Chat"
                description="Ask the AI about the current code context">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl I"/>
        </action>

        <!-- Explain code -->
        <action id="LLMCopilot.ExplainCode"
                class="com.llmcopilot.actions.ExplainCodeAction"
                text="LLM Copilot: Explain Code"
                description="Explain selected code">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift E"/>
        </action>

        <!-- Fix code -->
        <action id="LLMCopilot.FixCode"
                class="com.llmcopilot.actions.FixCodeAction"
                text="LLM Copilot: Fix Code"
                description="Fix bugs in selected code"/>

        <!-- Refactor -->
        <action id="LLMCopilot.RefactorCode"
                class="com.llmcopilot.actions.RefactorCodeAction"
                text="LLM Copilot: Refactor Code"
                description="Refactor selected code with a custom instruction">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift R"/>
        </action>

        <!-- Generate doc comment -->
        <action id="LLMCopilot.GenerateDocComment"
                class="com.llmcopilot.actions.GenerateDocCommentAction"
                text="LLM Copilot: Generate Doc Comment"
                description="Generate documentation comment for the declaration at cursor">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift D"/>
        </action>

        <!-- Generate tests -->
        <action id="LLMCopilot.GenerateTests"
                class="com.llmcopilot.actions.GenerateTestsAction"
                text="LLM Copilot: Generate Unit Tests"
                description="Generate unit tests for selected code">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift T"/>
        </action>

        <!-- Generate constructor -->
        <action id="LLMCopilot.GenerateConstructor"
                class="com.llmcopilot.actions.GenerateConstructorAction"
                text="LLM Copilot: Generate Constructor"
                description="Generate constructor for the current class"/>

        <!-- Generate getters/setters -->
        <action id="LLMCopilot.GenerateGettersSetters"
                class="com.llmcopilot.actions.GenerateGettersSettersAction"
                text="LLM Copilot: Generate Getters &amp; Setters"
                description="Generate getter and setter methods one field at a time"/>

        <!-- Implement interface -->
        <action id="LLMCopilot.ImplementInterface"
                class="com.llmcopilot.actions.ImplementInterfaceAction"
                text="LLM Copilot: Implement Interface"
                description="Generate implementations for interface methods"/>

        <!-- Selection context menu (Ctrl+Space on selection) -->
        <action id="LLMCopilot.ShowSelectionActions"
                class="com.llmcopilot.actions.ShowSelectionActionsAction"
                text="LLM Copilot: Selection Actions"
                description="Show AI actions for selected code">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl SPACE"/>
        </action>

        <!-- Commit message -->
        <action id="LLMCopilot.GenerateCommitMessage"
                class="com.llmcopilot.actions.GenerateCommitMessageAction"
                text="LLM Copilot: Generate Commit Message"
                description="Generate a commit message from the current diff">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift M"/>
        </action>

        <!-- Toggle enabled -->
        <action id="LLMCopilot.ToggleEnabled"
                class="com.llmcopilot.actions.ToggleEnabledAction"
                text="LLM Copilot: Toggle Enable/Disable"
                description="Toggle LLM Copilot on or off"/>

        <!-- Test connection -->
        <action id="LLMCopilot.TestConnection"
                class="com.llmcopilot.actions.TestConnectionAction"
                text="LLM Copilot: Test Connection"
                description="Test connection to the configured LLM provider"/>

        <!-- Group in Editor popup -->
        <group id="LLMCopilot.EditorPopupMenu" text="LLM Copilot" popup="true">
            <reference ref="LLMCopilot.ShowSelectionActions"/>
            <reference ref="LLMCopilot.ExplainCode"/>
            <reference ref="LLMCopilot.FixCode"/>
            <reference ref="LLMCopilot.RefactorCode"/>
            <reference ref="LLMCopilot.GenerateDocComment"/>
            <reference ref="LLMCopilot.GenerateConstructor"/>
            <reference ref="LLMCopilot.GenerateGettersSetters"/>
            <reference ref="LLMCopilot.ImplementInterface"/>
            <reference ref="LLMCopilot.GenerateTests"/>
            <separator/>
            <reference ref="LLMCopilot.InlineChat"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>

    </actions>
</idea-plugin>
